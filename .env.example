# Prisma datasource. Local dev defaults to SQLite (see packages/db/prisma/schema.prisma
# provider = "sqlite") so nothing extra needs to run. For staging/production, switch the
# schema's provider back to "postgresql" and point this at a real instance:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vessel_ticketing?schema=public"
DATABASE_URL="file:./dev.db"

# Upstash Redis (REST API — used by packages/redis for QR scan caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# apps/api
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Signs/verifies login JWTs. Generate a real secret for anything beyond local dev.
JWT_SECRET=dev-only-insecure-secret-change-me

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
